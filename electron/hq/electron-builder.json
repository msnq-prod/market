{
  "appId": "com.stones.hq",
  "productName": "ZAGARAMI admin",
  "artifactName": "ZAGARAMI-HQ-${version}-${arch}.${ext}",
  "directories": {
    "output": "dist-electron-hq"
  },
  "extraMetadata": {
    "main": "electron/hq/main.cjs",
    "stonesHq": {
      "apiOrigin": "https://zagarami.com"
    }
  },
  "files": [
    "dist/**/*",
    "electron/hq/**/*",
    "node_modules/ffmpeg-static/index.js",
    "node_modules/ffmpeg-static/package.json",
    "node_modules/ffmpeg-static/LICENSE",
    "node_modules/ffmpeg-static/ffmpeg",
    "node_modules/ffprobe-static/index.js",
    "node_modules/ffprobe-static/package.json",
    "node_modules/ffprobe-static/LICENSE",
    "node_modules/ffprobe-static/bin/**/*",
    "node_modules/better-sqlite3/**/*",
    "node_modules/bindings/**/*",
    "node_modules/file-uri-to-path/**/*",
    "node_modules/sharp/**/*",
    "node_modules/@img/**/*",
    "node_modules/detect-libc/**/*",
    "node_modules/semver/**/*",
    "node_modules/heic-convert/**/*",
    "node_modules/heic-decode/**/*",
    "node_modules/libheif-js/**/*",
    "node_modules/jpeg-js/**/*",
    "node_modules/pngjs/**/*",
    "!**/node_modules/electron/**",
    "!**/node_modules/electron-builder/**",
    "package.json"
  ],
  "asarUnpack": [
    "node_modules/better-sqlite3/build/Release/*.node",
    "node_modules/@img/sharp-*/lib/*.node",
    "node_modules/@img/sharp-libvips-*/lib/**/*",
    "node_modules/libheif-js/**/*.wasm",
    "node_modules/ffmpeg-static/ffmpeg",
    "node_modules/ffprobe-static/bin/**/*"
  ],
  "mac": {
    "icon": "electron/hq/assets/icon.icns",
    "target": [
      {
        "target": "dir",
        "arch": [
          "arm64",
          "x64"
        ]
      }
    ],
    "category": "public.app-category.business"
  },
  "win": {
    "target": [
      "nsis"
    ]
  },
  "linux": {
    "target": [
      "AppImage"
    ],
    "category": "Office"
  }
}
